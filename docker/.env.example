# =======================================================
# Automated LLM Adversarial Red Teaming & Safety Fuzzer
# Local Environment Configuration ($0 local stack)
# =======================================================

# Target Configuration (Local Ollama, OpenAI-compatible endpoint, or Mock LLM)
TARGET_URL=http://localhost:11434
MODEL_NAME=llama3
API_KEY=

# Fuzzing & Evaluation Settings
BENCHMARK_SCENARIOS=10
BENCHMARK_MAX_TURNS=3
BENCHMARK_STRATEGY=all

# Mock Engine Configuration (hardened or vulnerable)
MOCK_LLM_PORT=11435
MOCK_LLM_MODE=hardened

# Web Dashboard Port
DASHBOARD_PORT=8080

# Reports Output
REPORTS_DIR=./reports
